[Unit]
Description=Ritm community API (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ritm
Group=ritm
WorkingDirectory=/opt/ritm-api/app
EnvironmentFile=/opt/ritm-api/.env
ExecStart=/opt/ritm-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=3
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ritm-api

[Install]
WantedBy=multi-user.target
